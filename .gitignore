# --- C++ Artifacts ---
# Compiled binaries (executables)
cpp/main
cpp/engine
*.exe
*.out
*.app

# Object files and libraries
*.o
*.obj
*.a
*.lib
*.so
*.dll

# Debug symbols and IDE folders
*.dSYM/
.vscode/
.idea/
*.swp

# --- Python Artifacts ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/

# --- Benchmarks & Data ---
# Ignore large log files or temporary benchmark data
benchmarks/*.log
benchmarks/*.csv
!benchmarks/benchmark_results.txt  # Keep your main results file tracked

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini
